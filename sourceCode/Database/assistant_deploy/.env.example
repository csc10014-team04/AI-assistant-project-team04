# ============================================================================
# Environment Variables for Assistant Deployment (Docker Compose)
# Copy this file to .env and replace placeholder values before running:
# docker compose up -d
# ============================================================================

# MySQL Root & Application User Credentials
DB_ROOT_PASSWORD=secure_root_password_change_me
DB_USER=schedule_admin
DB_PASSWORD=schedule_admin_password_change_me

# HuggingFace Token (Required for gated Llama 3.1 model weights via vLLM)
HF_TOKEN=your_huggingface_access_token_here


# --- Backend AI / ops (optional) ---
# VLLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
# DATA_ENCRYPTION_KEY=change-me          # encrypts the per-user RAG index at rest
# INFERENCE_QUEUE_LOGGING=1              # write FIFO queue timings to inference_queue_logs
# TELEMETRY_INTERVAL_SECONDS=15          # sample RAM/VRAM/queue depth into telemetry_metric_logs (0 = off)
# CORS_ORIGINS=                           # comma separated; empty for the native Android app

# LLM_ALLOWED_HOSTS=26.211.52.63        # comma list of hosts/CIDRs allowed besides LAN/Tailscale (Radmin/Hamachi etc.)
